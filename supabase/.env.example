# Secrets for Edge Functions (`supabase secrets set` or Dashboard → Edge Functions → Secrets)
# Also used by local `supabase functions serve --env-file supabase/.env.local`
# Hosted Supabase injects SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.
# NOTE: RESEND_FROM must be a sender that Resend has verified for the domain you use.
# The default onboarding@resend.dev sender may work only when that domain is verified in Resend.

RESEND_API_KEY=
RESEND_FROM=Tshedza Finance <onboarding@resend.dev>
CONTACT_INBOX=

# Mock payment gateway. Must be exactly "true" or payment functions return 503.
# This does not collect real money. Replace with a live gateway before taking payments.
MOCK_PAYMENTS_ENABLED=true
MOCK_CHECKOUT_BASE_URL=http://localhost:5173/dashboard/repayments/checkout

# CORS. Production: comma-separated frontend origins. Local: set ALLOW_LOCAL_ORIGINS=true.
ALLOWED_ORIGINS=
ALLOW_LOCAL_ORIGINS=true
