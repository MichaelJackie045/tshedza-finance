# Copy to supabase/.env.production.local (gitignored) and fill in real values.
# Apply with: npx supabase secrets set --env-file supabase/.env.production.local
# Do not set ALLOW_LOCAL_ORIGINS in production.

RESEND_API_KEY=
RESEND_FROM=Tshedza Finance <noreply@yourdomain.co.za>
CONTACT_INBOX=

# Demo payments only. Leave unset (or any value other than true) to disable checkout.
MOCK_PAYMENTS_ENABLED=true
MOCK_CHECKOUT_BASE_URL=https://your-app.vercel.app/dashboard/repayments/checkout

# Comma-separated. Must match the browser origin exactly (scheme + host, no trailing slash).
ALLOWED_ORIGINS=https://your-app.vercel.app
