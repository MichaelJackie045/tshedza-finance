# Resend email (free tier) — copy to .env.notify (gitignored) and fill in.
# Create a key at https://resend.com/api-keys — do NOT commit real keys.

RESEND_API_KEY=
# Must be onboarding@resend.dev until you verify your own domain (cannot send FROM gmail.com)
NOTIFY_FROM_EMAIL=onboarding@resend.dev
NOTIFY_OPS_EMAIL=jackiemichael045@gmail.com

# Notes:
# - With onboarding@resend.dev, Resend only delivers to your Resend account email.
# - WhatsApp is click-to-chat only (no API key needed).
