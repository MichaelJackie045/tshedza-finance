# Copy these into Render → Environment (do not commit real secrets).

# Required for production
APP_JWT_SECRET=change-me-to-a-long-random-string
APP_UPLOAD_DIR=/tmp/uploads

# After Vercel deploy, set your real frontend origin (comma-separated OK):
# CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app,http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (optional)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev
NOTIFY_OPS_EMAIL=

# PayFast (optional — update URLs after both hosts exist)
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=https://YOUR-APP.vercel.app/dashboard/repayments/return
PAYFAST_CANCEL_URL=https://YOUR-APP.vercel.app/dashboard/repayments/cancel
PAYFAST_NOTIFY_URL=https://YOUR-API.onrender.com/api/payments/payfast/notify
