# Local defaults — replace with `supabase status` values after `supabase start`
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Do NOT commit real keys. Replace with runtime secret or set in your host/CI.
VITE_SUPABASE_ANON_KEY=REPLACE_ME_DO_NOT_COMMIT
