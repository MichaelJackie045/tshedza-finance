# Optional overrides for docker compose (copy to .env in project root).
# Compose reads a root .env automatically.

APP_JWT_SECRET=change-me-to-a-long-random-string
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email (optional — or put these in backend/.env.notify)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev
NOTIFY_OPS_EMAIL=

# PayFast (optional)
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_RETURN_URL=http://localhost:5173/dashboard/repayments/return
PAYFAST_CANCEL_URL=http://localhost:5173/dashboard/repayments/cancel
PAYFAST_NOTIFY_URL=http://localhost:8080/api/payments/payfast/notify
